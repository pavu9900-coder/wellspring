# WellSpring AI Environment Configuration Template
# Copy this file to .env and configure real credentials as needed.

# Application Environment
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# NVIDIA Hosted LLM API (P0 Requirement)
# Obtain free-tier API key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Configured for Nemotron 3.5 Lightning 30B:
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=30

# Supabase PostgreSQL Database (Migrations in backend/app/database/migrations)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MedlinePlus Health Knowledge Integration (P0/P1 Requirement)
# Official service: https://wsearch.nlm.nih.gov/ws/query
MEDLINEPLUS_ENABLED=true
MEDLINEPLUS_TOOL_NAME=wellspringhealth
MEDLINEPLUS_CONTACT_EMAIL=

# Open-Meteo Environmental Context (P2 Optional Requirement)
OPEN_METEO_ENABLED=true

# Frontend API Target (Public to browser)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
